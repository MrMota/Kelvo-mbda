# Copy to .env (never commit .env). Docker Compose reads it automatically.

# NVIDIA GPU: keep this line to give Ollama the GPU (needs the NVIDIA Container Toolkit).
# Delete it on a machine without an NVIDIA GPU.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# How long a model stays in GPU memory after the last message (default 30m with the GPU file).
OLLAMA_KEEP_ALIVE=30m

# Your account, created on the FIRST start only. After you've signed in once you can
# delete these two lines; change the password later in Settings -> Account.
# Leave them empty to use the one-time setup token from `docker compose logs kelvo`.
KELVO_USERNAME=
KELVO_PASSWORD=

# Who can reach Kelvo:
#   127.0.0.1      this machine only (default, safest)
#   100.x.y.z      this machine's Tailscale IP: your devices on your tailnet
#   0.0.0.0        every network this machine is on (home LAN only, never a public server)
KELVO_BIND=127.0.0.1
KELVO_PORT=7860

# Set to 1 when Kelvo is served over HTTPS (e.g. `tailscale serve`).
KELVO_SECURE_COOKIE=0
# Extra origins allowed to make changes, comma-separated, if a proxy rewrites the Host header.
# Example: https://my-box.my-tailnet.ts.net
KELVO_ALLOWED_ORIGINS=
